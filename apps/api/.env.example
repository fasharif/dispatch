# Copy to apps/api/.env for local development. Every variable is validated at start-up
# (src/config/env.ts); a missing or malformed value stops the process with a list of problems.

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=57100
# api = HTTP and WebSockets, worker = background jobs, all = both (development)
PROCESS_ROLE=all
# INSTANCE_ID=api-1                     # defaults to the host name

# ─── Data stores (docker compose up -d starts both) ─────────────────────────
DATABASE_URL=postgresql://dispatch:dispatch@localhost:57432/dispatch
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:57379

# ─── Secrets: 32+ random characters each, e.g. `openssl rand -base64 48` ────
# The values below are public examples. Production refuses them.
JWT_SECRET=change-me-dispatcher-session-secret-000000000000
JWT_TTL_MINUTES=480
TRACKING_TOKEN_SECRET=change-me-tracking-link-secret-0000000000000
TRACKING_LINK_TTL_HOURS=48

# ─── HTTP ───────────────────────────────────────────────────────────────────
# Tracking links point at `${PUBLIC_WEB_URL}/track/<token>`.
PUBLIC_WEB_URL=http://localhost:57300
CORS_ORIGINS=http://localhost:57300
TRUST_PROXY=false                        # true behind nginx or another proxy
THROTTLE_LIMIT=600                       # requests per minute per caller and route
AUTH_THROTTLE_LIMIT=10                   # login and device enrolment
AUTH_FAILURE_LIMIT=30                    # invalid device tokens per address and minute

# ─── Proof of delivery ──────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_PHOTO_BYTES=8388608
GEOFENCE_RADIUS_M=150
GEOFENCE_ACCURACY_ALLOWANCE_M=50

# ─── Drivers and locations ──────────────────────────────────────────────────
DRIVER_STALE_AFTER_S=120                 # older fixes are not auto-assigned
MAX_CLOCK_SKEW_S=120
LOCATION_STREAM_RETENTION_MIN=15         # resume window for reconnecting consoles
LOCATION_HISTORY_DAYS=30

# ─── Webhooks to the order system (TopFlow Hub, a portfolio demo) ───────────
# Leave WEBHOOK_URL empty to keep events in the outbox without sending them.
# TopFlow Hub's receiver: http://localhost:3000/integrations/dispatch/events
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_MS=2000
WEBHOOK_TIMEOUT_MS=10000

# ─── ETA ────────────────────────────────────────────────────────────────────
# With OSRM_URL set, ETAs come from OSRM (docker compose --profile osrm up -d osrm serves it on
# http://localhost:57500). Without it, a straight-line estimate is used.
OSRM_URL=
OSRM_TIMEOUT_MS=1500
ETA_SPEED_KMH=30
ETA_DETOUR_FACTOR=1.4
