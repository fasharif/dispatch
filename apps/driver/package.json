{
  "name": "@dispatch/driver",
  "version": "0.1.0",
  "private": true,
  "description": "Expo driver app: background location, an offline SQLite queue replayed with idempotency keys, pickup and proof of delivery.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bundle": "expo export --platform android --no-bytecode --output-dir .bundle-check"
  },
  "dependencies": {
    "@dispatch/shared": "*",
    "expo": "57.0.26",
    "expo-crypto": "57.0.3",
    "expo-image-picker": "57.0.20",
    "expo-location": "57.0.20",
    "expo-network": "57.0.2",
    "expo-secure-store": "57.0.4",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-task-manager": "57.0.21",
    "react": "19.3.0",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "eslint-config-expo": "57.0.2",
    "vitest": "5.0.3"
  }
}
