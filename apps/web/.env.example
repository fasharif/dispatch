# Copy to apps/web/.env.local for development. NEXT_PUBLIC_ values are built into the page.

# Where the browser reaches the API and its WebSockets. Empty means "same origin", which is how the
# compose stack serves it behind nginx.
NEXT_PUBLIC_API_URL=http://localhost:57100

# Basemap: a Protomaps PMTiles extract (scripts/fetch-basemap.sh writes public/tiles/dubai.pmtiles).
# When the file is missing the console falls back to MapLibre's demo tiles and says so.
NEXT_PUBLIC_BASEMAP_URL=/tiles/dubai.pmtiles
