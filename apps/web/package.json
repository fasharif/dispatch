{
  "name": "@dispatch/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js dispatcher console with a live MapLibre map, and the customer tracking page in English and Arabic.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs",
    "dev": "next dev -p 57300",
    "prebuild": "node scripts/copy-vendor.mjs",
    "build": "next build",
    "start": "next start -p 57300",
    "typecheck": "node scripts/copy-vendor.mjs && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@dispatch/shared": "*",
    "@mapbox/mapbox-gl-rtl-text": "0.4.0",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.11.2",
    "next": "16.3.6",
    "pmtiles": "4.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint-config-next": "16.3.6",
    "vitest": "5.0.2"
  }
}
